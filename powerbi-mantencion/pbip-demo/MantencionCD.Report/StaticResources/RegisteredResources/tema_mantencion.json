{
  "name": "Mantención CD",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#4A3AA7",
    "#E34948"
  ],
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#86B6EF",
  "minimum": "#CDE2FB",
  "null": "#898781",
  "background": "#FCFCFB",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FCFCFB"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F9F9F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 24,
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#52514E"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "values": [
          {
            "fontSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 9,
            "bold": true
          }
        ],
        "grid": [
          {
            "rowPadding": 4,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "gridVertical": false
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "values": [
          {
            "fontSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 9,
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "rowPadding": 4,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "titleFontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "showAxisTitle": false
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "position": "Top",
            "fontSize": 9,
            "showTitle": false
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "showAxisTitle": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "position": "Top",
            "fontSize": 9,
            "showTitle": false
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "showAxisTitle": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontSize": 10,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            }
          }
        ],
        "items": [
          {
            "fontSize": 9
          }
        ]
      }
    }
  }
}
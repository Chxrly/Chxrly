            "dataType": "int64",
            "sourceColumn": "Duracion_Min",
            "lineageTag": "7a509817-9d99-4660-92a5-676d126def42",
            "summarizeBy": "none"
          },
          {
            "name": "Observaciones",
            "dataType": "string",
            "sourceColumn": "Observaciones",
            "lineageTag": "b69db053-2f22-4ca3-a0b1-eb652a896ea8"
          },
          {
            "name": "Estado Ejecucion",
            "dataType": "string",
            "type": "calculated",
            "lineageTag": "c2e124de-eb2f-4fb3-8531-f84fa0d8e604",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    MantencionMensual[Estado] = \"Cancelada\", \"Cancelada\",",
              "    MantencionMensual[Estado] = \"Realizada\"",
              "        && NOT ISBLANK ( MantencionMensual[Fecha_Realizada] )",
              "        && MantencionMensual[Fecha_Realizada] <= MantencionMensual[Fecha_Programada], \"Realizada en fecha\",",
              "    MantencionMensual[Estado] = \"Realizada\", \"Realizada con atraso\",",
              "    MantencionMensual[Estado] = \"Reprogramada\"",
              "        && MantencionMensual[Fecha_Programada] < TODAY (), \"Atrasada\",",
              "    MantencionMensual[Estado] = \"Reprogramada\", \"Reprogramada\",",
              "    MantencionMensual[Fecha_Programada] < TODAY (), \"Atrasada\",",
              "    \"Programada\"",
              ")"
            ]
          }
        ],
        "partitions": [
          {
            "name": "MantencionMensual",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // DATOS DE EJEMPLO INCRUSTADOS — para conectar tu Google Sheet, reemplaza",
                "    // todo este código por power-query/conector-google-sheets/MantencionMensual.m",
                "    Datos = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"ID_OT\" = _t, #\"ID_Maquina\" = _t, #\"Tarea\" = _t, #\"Frecuencia\" = _t, #\"Fecha_Programada\" = _t, #\"Fecha_Realizada\" = _t, #\"Estado\" = _t, #\"Tecnico\" = _t, #\"Duracion_Min\" = _t, #\"Observaciones\" = _t]),",
                "    Tipos = Table.TransformColumnTypes(Datos, {{\"ID_OT\", type text}, {\"ID_Maquina\", type text}, {\"Tarea\", type text}, {\"Frecuencia\", type text}, {\"Fecha_Programada\", type date}, {\"Fecha_Realizada\", type date}, {\"Estado\", type text}, {\"Tecnico\", type text}, {\"Duracion_Min\", Int64.Type}, {\"Observaciones\", type text}}, \"es-CL\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "OT Programadas",
            "expression": [
              "CALCULATE ( COUNTROWS ( MantencionMensual ), MantencionMensual[Estado] <> \"Cancelada\" )"
            ],
            "lineageTag": "588290f8-39d5-48f5-93c0-83bab20f6716",
            "formatString": "#,0"
          },
          {
            "name": "OT Realizadas",
            "expression": [
              "CALCULATE ( COUNTROWS ( MantencionMensual ), MantencionMensual[Estado] = \"Realizada\" )"
            ],
            "lineageTag": "2b8e646f-b6ec-49aa-8c1b-27cbf10e5055",
            "formatString": "#,0"
          },
          {
            "name": "Cumplimiento PM %",
            "expression": [
              "DIVIDE ( [OT Realizadas], [OT Programadas] )"
            ],
            "lineageTag": "490cf7ce-a859-432c-a907-787a8b1d8474",
            "formatString": "0%"
          },
          {
            "name": "OT Realizadas En Fecha",
            "expression": [
              "COUNTROWS (",
              "    FILTER (",
              "        MantencionMensual,",
              "        MantencionMensual[Estado] = \"Realizada\"",
              "            && NOT ISBLANK ( MantencionMensual[Fecha_Realizada] )",
              "            && MantencionMensual[Fecha_Realizada] <= MantencionMensual[Fecha_Programada]",
              "    )",
              ")"
            ],
            "lineageTag": "0c49540e-72f6-45c3-80ea-c679fde21ee5",
            "formatString": "#,0"
          },
          {
            "name": "Puntualidad PM %",
            "expression": [
              "DIVIDE ( [OT Realizadas En Fecha], [OT Realizadas] )"
            ],
            "lineageTag": "a2c70759-86a3-4417-ab7e-530f9a1e04fd",
            "formatString": "0%"
          },
          {
            "name": "OT Atrasadas",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS (",
              "        FILTER (",
              "            MantencionMensual,",
              "            MantencionMensual[Estado] IN { \"Programada\", \"Reprogramada\" }",
              "                && MantencionMensual[Fecha_Programada] < TODAY ()",
              "        )",
              "    ),",
              "    REMOVEFILTERS ( Calendario )",
              ")"
            ],
            "lineageTag": "b04ab37a-0996-48e6-bf47-0a140b4c9b09",
            "formatString": "#,0"
          },
          {
            "name": "OT Proximas 7 Dias",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS (",
              "        FILTER (",
              "            MantencionMensual,",
              "            MantencionMensual[Estado] IN { \"Programada\", \"Reprogramada\" }",
              "                && MantencionMensual[Fecha_Programada] >= TODAY ()",
              "                && MantencionMensual[Fecha_Programada] <= TODAY () + 7",
              "        )",
              "    ),",
              "    REMOVEFILTERS ( Calendario )",
              ")"
            ],
            "lineageTag": "18196486-a44b-4a6a-abb1-a546f55be3f5",
            "formatString": "#,0"
          },
          {
            "name": "Dias Atraso Promedio",
            "expression": [
              "AVERAGEX (",
              "    FILTER (",
              "        MantencionMensual,",
              "        MantencionMensual[Estado] = \"Realizada\"",
              "            && NOT ISBLANK ( MantencionMensual[Fecha_Realizada] )",
              "            && MantencionMensual[Fecha_Realizada] > MantencionMensual[Fecha_Programada]",
              "    ),",
              "    INT ( MantencionMensual[Fecha_Realizada] - MantencionMensual[Fecha_Programada] )",
              ")"
            ],
            "lineageTag": "3aaee0a2-e5e3-4ee2-885c-042a46a726aa",
            "formatString": "#,0.0"
          },
          {
            "name": "Horas PM Ejecutadas",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( SUM ( MantencionMensual[Duracion_Min] ), MantencionMensual[Estado] = \"Realizada\" ),",
              "    60",
              ")"
            ],
            "lineageTag": "5b7408ab-3ea4-4dc5-95cb-725e3ddffa52",
            "formatString": "#,0.0"
          }
        ]
      },

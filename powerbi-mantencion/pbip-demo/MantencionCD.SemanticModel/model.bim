        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ADDCOLUMNS (",
                "    SELECTCOLUMNS ( CALENDARAUTO (), \"Fecha\", [Date] ),",
                "    \"Anio\", YEAR ( [Fecha] ),",
                "    \"MesNum\", MONTH ( [Fecha] ),",
                "    \"AnioMes\", FORMAT ( [Fecha], \"yyyy-MM\" ),",
                "    \"Mes\", FORMAT ( [Fecha], \"mmm yyyy\" ),",
                "    \"MesCorto\", FORMAT ( [Fecha], \"mmm\" ),",
                "    \"Semana\", WEEKNUM ( [Fecha], 2 ),",
                "    \"Dia\", DAY ( [Fecha] ),",
                "    \"DiaSemanaNum\", WEEKDAY ( [Fecha], 2 ),",
                "    \"DiaSemana\", FORMAT ( [Fecha], \"ddd\" ),",
                "    \"EsFinDeSemana\", WEEKDAY ( [Fecha], 2 ) > 5",
                ")"
              ]
            }
          }
        ]
      }

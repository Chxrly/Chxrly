        "partitions": [
          {
            "name": "Bitacora",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // DATOS DE EJEMPLO INCRUSTADOS — para conectar tu Google Sheet, reemplaza",
                "    // todo este código por power-query/conector-google-sheets/Bitacora.m",
                "    Datos = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Fecha\" = _t, #\"Turno\" = _t, #\"Tecnico\" = _t, #\"ID_Maquina\" = _t, #\"Tipo_Actividad\" = _t, #\"Descripcion\" = _t, #\"Estado_Maquina\" = _t, #\"Detencion_Min\" = _t, #\"Pendiente\" = _t, #\"Observaciones\" = _t, #\"Clase_Mantencion\" = _t, #\"TurnoNum\" = _t]),",
                "    Tipos = Table.TransformColumnTypes(Datos, {{\"Fecha\", type date}, {\"Turno\", type text}, {\"Tecnico\", type text}, {\"ID_Maquina\", type text}, {\"Tipo_Actividad\", type text}, {\"Descripcion\", type text}, {\"Estado_Maquina\", type text}, {\"Detencion_Min\", Int64.Type}, {\"Pendiente\", type text}, {\"Observaciones\", type text}, {\"Clase_Mantencion\", type text}, {\"TurnoNum\", Int64.Type}}, \"es-CL\")",
                "in",
                "    Tipos"
              ]
            }

        "measures": [
          {
            "name": "Actividades",
            "expression": [
              "COUNTROWS ( Bitacora )"
            ],
            "lineageTag": "6fdb9a1b-4c47-437d-a9b6-cd31375e1d26",
            "formatString": "#,0"
          },
          {
            "name": "Actividades Pendientes",
            "expression": [
              "CALCULATE ( COUNTROWS ( Bitacora ), Bitacora[Pendiente] = \"Sí\" )"
            ],
            "lineageTag": "d90f8f24-2a5f-4023-a51c-1bba1aae3803",
            "formatString": "#,0"
          },
          {
            "name": "Horas Detencion Bitacora",
            "expression": [
              "DIVIDE ( SUM ( Bitacora[Detencion_Min] ), 60 )"
            ],
            "lineageTag": "7183d514-8116-400d-8184-e5737197ba8e",
            "formatString": "#,0.0"
          },
          {
            "name": "Turnos Con Registro",
            "expression": [
              "COUNTROWS ( SUMMARIZE ( Bitacora, Bitacora[Fecha], Bitacora[Turno] ) )"
            ],
            "lineageTag": "3eb58b76-678d-4f42-8152-b9842959629b",
            "formatString": "#,0"
          },
          {
            "name": "Mantenciones Preventivas",
            "expression": [
              "CALCULATE ( COUNTROWS ( Bitacora ), Bitacora[Clase_Mantencion] = \"Preventiva\" )"
            ],
            "lineageTag": "e3fda7bb-8521-4116-b1f3-936072664577",
            "formatString": "#,0"
          },
          {
            "name": "Mantenciones Correctivas",
            "expression": [
              "CALCULATE ( COUNTROWS ( Bitacora ), Bitacora[Clase_Mantencion] = \"Correctiva\" )"
            ],
            "lineageTag": "1cf4ddd7-6720-4143-a4da-34a8bf1fd1a5",
            "formatString": "#,0"
          },
          {
            "name": "Mantenciones de Rutina",
            "expression": [
              "CALCULATE ( COUNTROWS ( Bitacora ), Bitacora[Clase_Mantencion] = \"Rutina\" )"
            ],
            "lineageTag": "01b3237f-2874-4f2c-9b73-8aace1934f21",
            "formatString": "#,0"
          },
          {
            "name": "% Trabajo Planificado",
            "expression": [
              "DIVIDE (",
              "    [Mantenciones Preventivas] + [Mantenciones de Rutina],",
              "    [Mantenciones Preventivas] + [Mantenciones de Rutina] + [Mantenciones Correctivas]",
              ")"
            ],
            "lineageTag": "9ac50e9f-5baa-456b-aed4-6e030f38dda5",
            "formatString": "0%"
          }
        ]

        "partitions": [
          {
            "name": "Fallas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // DATOS DE EJEMPLO INCRUSTADOS — para conectar tu Google Sheet, reemplaza",
                "    // todo este código por power-query/conector-google-sheets/Fallas.m",
                "    Datos = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"ID_Falla\" = _t, #\"Fecha_Hora_Falla\" = _t, #\"ID_Maquina\" = _t, #\"Turno_Detecta\" = _t, #\"Tipo_Falla\" = _t, #\"Severidad\" = _t, #\"Descripcion_Falla\" = _t, #\"Estado\" = _t, #\"Fecha_Hora_Cierre\" = _t, #\"Detencion_Min\" = _t, #\"Reparacion_Realizada\" = _t, #\"Repuestos_Usados\" = _t, #\"Tecnico_Responsable\" = _t, #\"Fecha\" = _t]),",
                "    Tipos = Table.TransformColumnTypes(Datos, {{\"ID_Falla\", type text}, {\"Fecha_Hora_Falla\", type datetime}, {\"ID_Maquina\", type text}, {\"Turno_Detecta\", type text}, {\"Tipo_Falla\", type text}, {\"Severidad\", type text}, {\"Descripcion_Falla\", type text}, {\"Estado\", type text}, {\"Fecha_Hora_Cierre\", type datetime}, {\"Detencion_Min\", Int64.Type}, {\"Reparacion_Realizada\", type text}, {\"Repuestos_Usados\", type text}, {\"Tecnico_Responsable\", type text}, {\"Fecha\", type date}}, \"es-CL\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Maquinas Intervenidas",
            "expression": [
              "DISTINCTCOUNT ( Bitacora[ID_Maquina] )"
            ],
            "lineageTag": "dd00bbfb-7c13-48f1-b738-8cab34c4c63d",
            "formatString": "#,0"
          },
          {
            "name": "Numero Fallas",
            "expression": [
              "COUNTROWS ( Fallas )"
            ],
            "lineageTag": "a3b08840-fbe3-4458-92e2-db112bf58a63",
            "formatString": "#,0"
          },
          {
            "name": "Fallas Abiertas",
            "expression": [
              "CALCULATE ( COUNTROWS ( Fallas ), Fallas[Estado] <> \"Cerrada\" )"
            ],
            "lineageTag": "8e85ad7d-154e-4c82-9da8-d67e5235b594",
            "formatString": "#,0"
          },
          {
            "name": "Fallas Abiertas (actual)",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( Fallas ),",
              "    Fallas[Estado] <> \"Cerrada\",",
              "    REMOVEFILTERS ( Calendario )",
              ")"
            ],
            "lineageTag": "f63b3eff-8ad8-4c4d-aae2-478bf5126bfe",
            "formatString": "#,0"
          },
          {
            "name": "Fallas Criticas",
            "expression": [
              "CALCULATE ( COUNTROWS ( Fallas ), Fallas[Severidad] = \"Crítica\" )"
            ],
            "lineageTag": "71dc6458-8076-46c2-a3b2-91d02ab174c5",
            "formatString": "#,0"
          },
          {
            "name": "Maquinas Con Falla Abierta",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Fallas[ID_Maquina] ),",
              "    Fallas[Estado] <> \"Cerrada\",",
              "    REMOVEFILTERS ( Calendario )",
              ")"
            ],
            "lineageTag": "a981212b-88e8-45d6-a857-a1815f005149",
            "formatString": "#,0"
          },
          {
            "name": "Equipos Con Falla",
            "expression": [
              "DISTINCTCOUNT ( Fallas[ID_Maquina] )"
            ],
            "lineageTag": "34443f3f-2ca5-4328-a475-bbefef0d013e",
            "formatString": "#,0"
          },
          {
            "name": "Minutos Detencion Fallas",
            "expression": [
              "SUM ( Fallas[Detencion_Min] )"
            ],
            "lineageTag": "133a179f-6ab1-41ab-a18a-4d6b0dc6137e",
            "formatString": "#,0"
          },
          {
            "name": "Horas Detencion Fallas",
            "expression": [
              "DIVIDE ( [Minutos Detencion Fallas], 60 )"
            ],
            "lineageTag": "2108e2e5-44b5-4804-9859-07e5cf2dc661",
            "formatString": "#,0.0"
          },
          {
            "name": "MTTR Horas",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( AVERAGE ( Fallas[Detencion_Min] ), Fallas[Estado] = \"Cerrada\" ),",
              "    60",
              ")"
            ],
            "lineageTag": "fe2fb8f1-92ed-40b1-911c-9bf08e17d40c",
            "formatString": "#,0.0"
          },
          {
            "name": "Horas Operacion por Dia",
            "expression": [
              "24"
            ],
            "lineageTag": "65548485-60d9-4d1f-9ef3-6ae808eaee12",
            "formatString": "#,0"
          },
          {
            "name": "Horas Operacion Estimadas",
            "expression": [
              "[Horas Operacion por Dia]",
              "    * COUNTROWS ( Calendario )",
              "    * DISTINCTCOUNT ( Maquinas[ID_Maquina] )"
            ],
            "lineageTag": "608fc21f-7864-45c7-ae73-c98640dc7e87",
            "formatString": "#,0"
          },
          {
            "name": "MTBF Horas",
            "expression": [
              "DIVIDE (",
              "    [Horas Operacion Estimadas] - [Horas Detencion Fallas],",
              "    [Numero Fallas]",
              ")"
            ],
            "lineageTag": "4c616cd6-c1a2-4542-9252-b69877dfaf8a",
            "formatString": "#,0.0"
          },
          {
            "name": "Disponibilidad %",
            "expression": [
              "DIVIDE (",
              "    [Horas Operacion Estimadas] - [Horas Detencion Fallas],",
              "    [Horas Operacion Estimadas]",
              ")"
            ],
            "lineageTag": "46a0b41b-0a90-41b7-87f5-e820f04b20fd",
            "formatString": "0%"
          },
          {
            "name": "Antiguedad Backlog Dias",
            "expression": [
              "AVERAGEX (",
              "    CALCULATETABLE (",
              "        FILTER ( Fallas, Fallas[Estado] <> \"Cerrada\" ),",
              "        REMOVEFILTERS ( Calendario )",
              "    ),",
              "    INT ( TODAY () - Fallas[Fecha] )",
              ")"
            ],
            "lineageTag": "a4636689-fc86-4fce-8bba-ee2ce59c3a59",
            "formatString": "#,0.0"
          },
          {
            "name": "Antiguedad Backlog Max Dias",
            "expression": [
              "MAXX (",
              "    CALCULATETABLE (",
              "        FILTER ( Fallas, Fallas[Estado] <> \"Cerrada\" ),",
              "        REMOVEFILTERS ( Calendario )",
              "    ),",
              "    INT ( TODAY () - Fallas[Fecha] )",
              ")"
            ],
            "lineageTag": "a4405eda-1d4e-49ff-ae39-0a3eeae4d3fe",
            "formatString": "#,0"
          },
          {
            "name": "% Fallas Resueltas Mismo Dia",
            "expression": [
              "VAR Cerradas =",
              "    FILTER (",
              "        Fallas,",
              "        Fallas[Estado] = \"Cerrada\" && NOT ISBLANK ( Fallas[Fecha_Hora_Cierre] )",
              "    )",
              "RETURN",
              "    DIVIDE (",
              "        COUNTROWS (",
              "            FILTER ( Cerradas, INT ( Fallas[Fecha_Hora_Cierre] ) = INT ( Fallas[Fecha_Hora_Falla] ) )",
              "        ),",
              "        COUNTROWS ( Cerradas )",
              "    )"
            ],
            "lineageTag": "99cb970e-ed47-4e77-9cf6-8eae3ab805aa",
            "formatString": "0%"
          },
          {
            "name": "Fallas Reincidentes 30d",
            "expression": [
              "COUNTROWS (",
              "    FILTER (",
              "        Fallas,",
              "        VAR EquipoActual = Fallas[ID_Maquina]",
              "        VAR TipoActual = Fallas[Tipo_Falla]",
              "        VAR FechaActual = Fallas[Fecha_Hora_Falla]",
              "        RETURN",
              "            NOT ISEMPTY (",
              "                FILTER (",
              "                    ALL ( Fallas ),",
              "                    Fallas[ID_Maquina] = EquipoActual",
              "                        && Fallas[Tipo_Falla] = TipoActual",
              "                        && Fallas[Fecha_Hora_Falla] < FechaActual",
              "                        && Fallas[Fecha_Hora_Falla] >= FechaActual - 30",
              "                )",
              "            )",
              "    )",
              ")"
            ],
            "lineageTag": "b139fd80-b433-49e6-abde-93ef5bbf4721",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "MantencionMensual",
        "lineageTag": "0a351a84-006e-4857-a925-aef9f47bdc7b",
        "columns": [
          {
            "name": "ID_OT",
            "dataType": "string",
            "sourceColumn": "ID_OT",
            "lineageTag": "3714a5b1-1059-4f8a-9edf-532ad7a79ee4"
